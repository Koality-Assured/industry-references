{
  "": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "captured_at_utc": {
      "type": "string"
    },
    "advisory_only": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "tier": {
            "type": "string"
          },
          "version_note": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "sources"
  ]
}