{
  "": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "captured_at_utc": {
      "type": "string"
    },
    "advisory_only": {
      "type": "boolean"
    },
    "techniques": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tactics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "techniques"
  ]
}